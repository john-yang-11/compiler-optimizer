fn next(n) {
  let s = 0;
  while (n > 0) {
    let d = n % 10;
    s = s + d * d;
    n = n / 10;
  }
  return s;
}

fn is_happy(n) {
  let steps = 0;
  while (n != 1 && n != 4) {
    n = next(n);
    steps = steps + 1;
  }
  return n == 1;
}

fn main() {
  let i = 1;
  while (i <= 50) {
    if (is_happy(i)) {
      print(i);
    }
    i = i + 1;
  }
}
