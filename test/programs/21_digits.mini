fn digit_sum(n) {
  let s = 0;
  while (n > 0) {
    s = s + n % 10;
    n = n / 10;
  }
  return s;
}

fn reverse(n) {
  let r = 0;
  while (n > 0) {
    r = r * 10 + n % 10;
    n = n / 10;
  }
  return r;
}

fn main() {
  print(digit_sum(987654321));
  print(reverse(12345));
  print(reverse(1200));
  print(digit_sum(0));
}
