fn max(a, b) {
  if (a > b) {
    return a;
  }
  return b;
}

fn min(a, b) {
  if (a < b) {
    return a;
  }
  return b;
}

fn clamp(x, lo, hi) {
  return max(lo, min(x, hi));
}

fn main() {
  print(max(3, 9));
  print(min(3, 9));
  print(clamp(15, 0, 10));
  print(clamp(-5, 0, 10));
  print(clamp(5, 0, 10));
  let i = 0;
  let best = -1000;
  while (i < 20) {
    best = max(best, (i * 7) % 13);
    i = i + 1;
  }
  print(best);
}
