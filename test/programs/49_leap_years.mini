fn is_leap(y) {
  return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0;
}

fn main() {
  let count = 0;
  let y = 1900;
  while (y <= 2100) {
    if (is_leap(y)) {
      count = count + 1;
    }
    y = y + 1;
  }
  print(count);
  print(is_leap(1900));
  print(is_leap(2000));
  print(is_leap(2024));
  print(is_leap(2100));
}
