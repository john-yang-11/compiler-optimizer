fn classify(n) {
  if (n < 0) {
    if (n < -100) {
      return -2;
    } else {
      return -1;
    }
  } else {
    if (n == 0) {
      return 0;
    } else {
      if (n < 10) {
        return 1;
      } else if (n < 100) {
        return 2;
      } else {
        return 3;
      }
    }
  }
}

fn main() {
  print(classify(-500));
  print(classify(-5));
  print(classify(0));
  print(classify(7));
  print(classify(42));
  print(classify(1000));
}
