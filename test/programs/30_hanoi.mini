fn count_moves(n, from, to, via) {
  if (n == 0) {
    return 0;
  }
  let a = count_moves(n - 1, from, via, to);
  let b = count_moves(n - 1, via, to, from);
  return a + b + 1;
}

fn moves(n, from, to, via) {
  if (n > 0) {
    moves(n - 1, from, via, to);
    print(from * 10 + to);
    moves(n - 1, via, to, from);
  }
}

fn main() {
  print(count_moves(1, 1, 3, 2));
  print(count_moves(5, 1, 3, 2));
  print(count_moves(12, 1, 3, 2));
  moves(3, 1, 3, 2);
}
